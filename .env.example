# Only for authorized crawl sources. Use a truthful public contact address.
CRAWLER_USER_AGENT=ExampleResearchCrawler/0.1 (+mailto:operator@example.org)
SEARCH_DATABASE_PATH=/data/search.db
SEARCH_SCHEMA_PATH=/app/schema/sqlite.sql
SEARCH_RAW_DIR=/data/raw

# Optional model runtime; model files download on first use. Pin immutable revisions for production.
SEARCH_SEMANTIC_ENABLED=0
SEARCH_RERANK_ENABLED=0
SEARCH_EMBEDDING_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
SEARCH_EMBEDDING_MODEL_REVISION=main
SEARCH_RERANKER_MODEL_ID=cross-encoder/ms-marco-MiniLM-L6-v2
SEARCH_RERANKER_MODEL_REVISION=main
